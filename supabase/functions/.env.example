# ------------------------------------------------------------------
# Edge Function secrets (server-side only).
# Local:    copy to supabase/functions/.env  (git-ignored)
# Deployed: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by Supabase for deployed and local functions.
# ------------------------------------------------------------------

# Amazon SES v2 — IAM user/role scoped to SES only; rotate keys
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_FROM_FALLBACK=
# Emails per second the worker may send (SES sandbox: 1). Raise after production access.
SES_MAX_SEND_RATE=1
# SNS topic that the SES configuration set publishes events to (ses-events function)
SES_EVENTS_TOPIC_ARN=
# Local dev only: fake SES (no AWS calls). Refused against a hosted project.
# SES_MOCK=true

# Send worker tuning (optional)
# WORKER_TIME_BUDGET_MS=45000
# WORKER_BATCH=10

# AI Email Writer (provider adapter)
AI_PROVIDER=
AI_API_KEY=

# App
APP_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the functions (CORS)
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the functions, used in List-Unsubscribe headers
# (hosted: https://<ref>.supabase.co/functions/v1; local: http://127.0.0.1:54321/functions/v1)
PUBLIC_FUNCTIONS_URL=
# Random 32+ char secret: cron -> worker calls. MUST equal the Vault secret `mp_worker_secret`.
# Local value is fixed in supabase/seed.sql: local-dev-only-worker-secret-not-for-production-use
INTERNAL_WORKER_SECRET=
# Random 32+ char secret: HMAC for unsubscribe tokens (rotating it invalidates old links)
UNSUBSCRIBE_SIGNING_SECRET=
