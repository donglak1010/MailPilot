# ------------------------------------------------------------------
# Frontend (public, bundled into the browser). Copy to .env.local.
# Only the Supabase URL and PUBLISHABLE key belong here.
# NEVER put service-role/secret keys, AWS or AI keys in VITE_ vars.
# ------------------------------------------------------------------

# Local dev: values printed by `supabase status`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
